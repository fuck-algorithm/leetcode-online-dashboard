// 统计卡片组件 - 扁平化设计
const StatCard: React.FC<{
  icon: React.ReactNode;
  title: string;
  value: React.ReactNode;
  subTitle?: string;
  trend?: number;
  color: string;
  large?: boolean;
}> = ({ icon, title, value, subTitle, trend, color, large = false }) => (
  <div style={{
    background: '#fff',
    borderRadius: 16,
    padding: large ? 32 : 24,
    border: '1px solid #f0f0f0',
    display: 'flex',
    alignItems: 'center',
    gap: large ? 20 : 16,
    transition: 'all 0.3s',
    height: '100%'
  }}>
    <div style={{
      width: large ? 64 : 56,
      height: large ? 64 : 56,
      borderRadius: 14,
      background: color,
      display: 'flex',
      alignItems: 'center',
      justifyContent: 'center',
      fontSize: large ? 28 : 24,
      color: '#fff',
      flexShrink: 0
    }}>
      {icon}
    </div>
    <div style={{ flex: 1 }}>
      <div style={{ fontSize: 13, color: '#8c8c8c', marginBottom: 6, fontWeight: 500 }}>{title}</div>
      <div style={{ 
        fontSize: large ? 36 : 28, 
        fontWeight: 700, 
        color: '#262626', 
        lineHeight: 1.2,
        letterSpacing: '-0.5px'
      }}>
        {value}
      </div>
      {(subTitle || trend !== undefined) && (
        <div style={{ fontSize: 12, color: '#8c8c8c', marginTop: 6, display: 'flex', alignItems: 'center', gap: 8 }}>
          {subTitle}
          {trend !== undefined && <TrendIndicator value={trend} />}
        </div>
      )}
    </div>
  </div>
);

const Home: React.FC = () => {
  const [problems, setProblems] = useState<Problem[]>([]);
  const [loading, setLoading] = useState(true);
  const [stats, setStats] = useState({
    totalOnline: 0,
    totalProblems: 0,
    hotProblem: null as Problem | null,
  });

  const [lastUpdateTime, setLastUpdateTime] = useState<string>('');

  useWebSocket((data) => {
    if (data.type === 'batch_update' && data.problems) {
      const wsProblems: WSProblem[] = data.problems;
      
      const updatedProblems: Problem[] = wsProblems.map(p => ({
        id: p.frontend_id,
        frontend_id: p.frontend_id,
        slug: p.slug,
        title: p.title_cn || p.title || formatSlug(p.slug),
        difficulty: 'Medium' as 'Easy' | 'Medium' | 'Hard',
        acceptance: 0,
        online_count: p.online_count,
        last_updated: new Date(p.last_updated * 1000).toISOString(),
      }));

      setProblems(updatedProblems);
      
      const totalOnline = wsProblems.reduce((sum, p) => sum + p.online_count, 0);
      const hotProblem = wsProblems.length > 0
        ? wsProblems.reduce((max, p) => p.online_count > max.online_count ? p : max, wsProblems[0])
        : null;

      setStats({
        totalOnline,
        totalProblems: wsProblems.length,
        hotProblem: hotProblem ? {
          id: hotProblem.frontend_id,
          frontend_id: hotProblem.frontend_id,
          slug: hotProblem.slug,
          title: hotProblem.title_cn || hotProblem.title || formatSlug(hotProblem.slug),
          difficulty: 'Medium' as 'Easy' | 'Medium' | 'Hard',
          acceptance: 0,
          online_count: hotProblem.online_count,
          last_updated: new Date(hotProblem.last_updated * 1000).toISOString(),
        } : null,
      });
      
      setLastUpdateTime(new Date().toLocaleTimeString());
      setLoading(false);
    }
  });

  // 计算统计数据
  const computedStats = useMemo(() => {
    if (problems.length === 0) return null;
    
    const totalOnline = problems.reduce((sum, p) => sum + p.online_count, 0);
    const avgOnline = Math.round(totalOnline / problems.length);
    const maxOnline = Math.max(...problems.map(p => p.online_count));
    const minOnline = Math.min(...problems.map(p => p.online_count));
    const medianOnline = problems.map(p => p.online_count).sort((a, b) => a - b)[Math.floor(problems.length / 2)];
    
    // 热门题目占比 (Top 10)
    const top10Online = problems
      .slice()
      .sort((a, b) => b.online_count - a.online_count)
      .slice(0, 10)
      .reduce((sum, p) => sum + p.online_count, 0);
    const top10Percentage = Math.round((top10Online / totalOnline) * 100);
    
    // 活跃度分布
    const activeProblems = problems.filter(p => p.online_count > 100).length;
    const veryActiveProblems = problems.filter(p => p.online_count > 300).length;
    
    return {
      totalOnline,
      avgOnline,
      maxOnline,
      minOnline,
      medianOnline,
      top10Percentage,
      activeProblems,
      veryActiveProblems,
    };
  }, [problems]);

  const topProblems = (problems || [])
    .slice()
    .sort((a, b) => (b?.online_count || 0) - (a?.online_count || 0))
    .slice(0, 10);


  if (loading) return (
    <div style={{ 
      minHeight: '100vh', 
      display: 'flex', 
      alignItems: 'center', 
      justifyContent: 'center',
      background: 'linear-gradient(135deg, #f5f7fa 0%, #e4e7f1 100%)'
    }}>
      <Spin size="large" />
    </div>
  );

  return (
    <div style={{ background: '#f5f7fa', minHeight: '100vh' }}>
      {/* ========== Hero Section ========== */}
      <section style={{
        background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
        padding: '80px 24px 100px',
        position: 'relative',
        overflow: 'hidden'
      }}>
        {/* 背景装饰 */}
        <div style={{
          position: 'absolute',
          top: -100,
          right: -100,
          width: 400,
          height: 400,
          borderRadius: '50%',
          background: 'rgba(255,255,255,0.1)',
          filter: 'blur(60px)'
        }} />
        <div style={{
          position: 'absolute',
          bottom: -50,
          left: -50,
          width: 300,
          height: 300,
          borderRadius: '50%',
          background: 'rgba(255,255,255,0.08)',
          filter: 'blur(40px)'
        }} />
        
        <div style={{ maxWidth: 1200, margin: '0 auto', position: 'relative', zIndex: 1 }}>
          <Row gutter={[48, 48]} align="middle">
            <Col xs={24} lg={14}>
              <div style={{ marginBottom: 24 }}>
                <Badge 
                  status="success" 
                  text={<span style={{ color: '#fff', fontSize: 14, fontWeight: 500 }}>● 实时数据推送中</span>} 
                  style={{ background: 'rgba(255,255,255,0.2)', padding: '6px 12px', borderRadius: 20 }}
                />
              </div>
              
              <h1 style={{
                fontSize: 56,
                fontWeight: 800,
                color: '#fff',
                lineHeight: 1.1,
                marginBottom: 24,
                letterSpacing: '-1px'
              }}>
                LeetCode Hot 100
                <br />
                <span style={{ fontWeight: 400 }}>实时刷题监控</span>
              </h1>
              
              <p style={{
                fontSize: 20,
                color: 'rgba(255,255,255,0.9)',
                lineHeight: 1.6,
                marginBottom: 32,
                maxWidth: 500
              }}>
                实时监控 LeetCode 热门 100 题的在线刷题人数，
                掌握算法学习趋势，发现最受欢迎的题目。
              </p>
              
              <Space size="middle">
                <Link to="/rankings">
                  <Button 
                    type="primary" 
                    size="large"
                    icon={<RocketOutlined />}
                    style={{
                      height: 48,
                      padding: '0 32px',
                      fontSize: 16,
                      fontWeight: 600,
                      borderRadius: 12,
                      background: '#fff',
                      color: '#667eea',
                      border: 'none',
                      boxShadow: '0 8px 24px rgba(0,0,0,0.15)'
                    }}
                  >
                    查看排行榜
                  </Button>
                </Link>
                <Link to="/statistics">
                  <Button 
                    size="large"
                    icon={<BarChartOutlined />}
                    style={{
                      height: 48,
                      padding: '0 32px',
                      fontSize: 16,
                      fontWeight: 500,
                      borderRadius: 12,
                      background: 'rgba(255,255,255,0.15)',
                      color: '#fff',
                      border: '1px solid rgba(255,255,255,0.3)'
                    }}
                  >
                    详细统计
                  </Button>
                </Link>
              </Space>
              
              <div style={{ marginTop: 40, display: 'flex', gap: 32 }}>
                <div>
                  <div style={{ fontSize: 28, fontWeight: 700, color: '#fff' }}>
                    <AnimatedNumber value={stats.totalProblems} />
                  </div>
                  <div style={{ fontSize: 14, color: 'rgba(255,255,255,0.7)' }}>监控题目</div>
                </div>
                <div>
                  <div style={{ fontSize: 28, fontWeight: 700, color: '#fff' }}>
                    <AnimatedNumber value={stats.totalOnline} />
                  </div>
                  <div style={{ fontSize: 14, color: 'rgba(255,255,255,0.7)' }}>当前在线</div>
                </div>
                <div>
                  <div style={{ fontSize: 28, fontWeight: 700, color: '#fff' }}>30s</div>
                  <div style={{ fontSize: 14, color: 'rgba(255,255,255,0.7)' }}>更新频率</div>
                </div>
              </div>
            </Col>
            
            <Col xs={24} lg={10}>
              {/* 实时数据卡片 */}
              <div style={{
                background: 'rgba(255,255,255,0.1)',
                backdropFilter: 'blur(10px)',
                borderRadius: 20,
                padding: 24,
                border: '1px solid rgba(255,255,255,0.2)'
              }}>
                <div style={{ display: 'flex', alignItems: 'center', gap: 12, marginBottom: 20 }}>
                  <div style={{
                    width: 12,
                    height: 12,
                    borderRadius: '50%',
                    background: '#52c41a',
                    animation: 'pulse 2s infinite'
                  }} />
                  <span style={{ color: '#fff', fontSize: 16, fontWeight: 600 }}>实时热门题目</span>
                </div>
                
                <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
                  {topProblems.slice(0, 5).map((item, index) => (
                    <div key={item.id} style={{
                      display: 'flex',
                      alignItems: 'center',
                      gap: 12,
                      padding: '12px 16px',
                      background: 'rgba(255,255,255,0.1)',
                      borderRadius: 10,
                      transition: 'all 0.3s'
                    }}>
                      <div style={{
                        width: 24,
                        height: 24,
                        borderRadius: 6,
                        background: index < 3 ? ['#ff4d4f', '#ff7a45', '#ffa940'][index] : 'rgba(255,255,255,0.2)',
                        color: '#fff',
