              </div>
            </Col>
          </Row>
        </div>
      </section>

      {/* ========== Features Section ========== */}
      <section style={{ padding: '80px 24px', maxWidth: 1200, margin: '0 auto' }}>
        <div style={{ textAlign: 'center', marginBottom: 56 }}>
          <h2 style={{ fontSize: 36, fontWeight: 700, color: '#262626', marginBottom: 16 }}>
