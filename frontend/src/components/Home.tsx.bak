                      <div style={{ flex: 1, color: '#fff', fontSize: 14, fontWeight: 500, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                        {item.title}
                      </div>
                      <div style={{ color: '#fff', fontSize: 14, fontWeight: 600 }}>
                        {item.online_count.toLocaleString()}
