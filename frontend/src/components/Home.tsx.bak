                        }}
                      >
                        <div style={{ 
                          width: 32, 
                          height: 32, 
                          borderRadius: 8,
                          background: index < 3 ? rankColor : '#f5f5f5',
                          color: index < 3 ? '#fff' : '#8c8c8c',
                          display: 'flex',
                          alignItems: 'center',
                          justifyContent: 'center',
                          fontWeight: 700,
                          fontSize: 14,
                          flexShrink: 0
                        }}>
                          {index + 1}
                        </div>
                        
                        <div style={{ flex: 1, minWidth: 0 }}>
                          <div style={{ display: 'flex', alignItems: 'center', gap: 10, marginBottom: 4 }}>
                            <Link 
                              to={`https://leetcode.cn/problems/${item.slug}`} 
                              target="_blank"
                              style={{ 
                                color: '#262626', 
                                fontWeight: 600,
                                fontSize: 15,
                                overflow: 'hidden',
                                textOverflow: 'ellipsis',
                                whiteSpace: 'nowrap'
                              }}
                            >
                              {item.title}
                            </Link>
                            <Tag 
                              style={{ 
                                background: difficultyColors[item.difficulty]?.bg,
                                color: difficultyColors[item.difficulty]?.text,
                                border: `1px solid ${difficultyColors[item.difficulty]?.border}`,
                                fontSize: 11,
                                padding: '0 8px',
                                margin: 0,
                                flexShrink: 0,
                                fontWeight: 500
                              }}
                            >
                              {item.difficulty}
                            </Tag>
                          </div>
                          <div style={{ fontSize: 13, color: '#8c8c8c' }}>
                            slug: {item.slug}
                          </div>
                        </div>
                        
                        <div style={{ display: 'flex', alignItems: 'center', gap: 16, flexShrink: 0 }}>
                          <ActivityHeatmap intensity={intensity} />
                          <div style={{ 
                            minWidth: 60,
                            textAlign: 'right',
                            fontWeight: 700,
                            color: intensity > 60 ? '#fa8c16' : '#262626',
                            fontSize: 16
                          }}>
                            {item.online_count.toLocaleString()}
                          </div>
                          <Tooltip title="查看历史趋势">
                            <Link to={`/history?problemId=${item.id}`} style={{ color: '#1890ff', fontSize: 16 }}>
                              <HistoryOutlined />
                            </Link>
                          </Tooltip>
                        </div>
                      </div>
                    );
                  }}
                />
              </Card>
            </Col>
            
            <Col xs={24} lg={8}>
              {/* 难度分布 */}
              <Card 
                title={
                  <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                    <ThunderboltOutlined style={{ color: '#722ed1' }} />
                    <span style={{ fontSize: 16, fontWeight: 600 }}>难度分布</span>
                  </div>
                }
                style={{ borderRadius: 16, border: '1px solid #f0f0f0', marginBottom: 24 }}
                headStyle={{ borderBottom: '1px solid #f0f0f0', padding: '16px 20px' }}
                bodyStyle={{ padding: '20px' }}
              >
                {['Easy', 'Medium', 'Hard'].map(diff => {
                  const count = problems.filter(p => p.difficulty === diff).length;
                  const online = problems.filter(p => p.difficulty === diff).reduce((s, p) => s + p.online_count, 0);
                  const percentage = problems.length > 0 ? Math.round((count / problems.length) * 100) : 0;
                  const colors = difficultyColors[diff];
                  
                  return (
                    <div key={diff} style={{ marginBottom: 20 }}>
                      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 8 }}>
                        <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
                          <div style={{
                            width: 12,
                            height: 12,
                            borderRadius: 3,
                            background: colors.text
                          }} />
                          <span style={{ fontWeight: 600, color: '#262626', fontSize: 14 }}>{diff}</span>
                        </div>
                        <div style={{ textAlign: 'right' }}>
                          <div style={{ fontWeight: 700, color: '#262626', fontSize: 15 }}>{count} 题</div>
                          <div style={{ fontSize: 12, color: '#8c8c8c' }}>{online.toLocaleString()} 人在线</div>
                        </div>
                      </div>
                      <Progress 
                        percent={percentage} 
                        showInfo={false}
                        strokeColor={colors.text}
                        trailColor="#f5f5f5"
                        strokeWidth={8}
                        style={{ margin: 0 }}
                      />
                    </div>
                  );
                })}
              </Card>

              {/* 活跃度统计 */}
              <Card 
                title={
                  <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                    <RiseOutlined style={{ color: '#52c41a' }} />
                    <span style={{ fontSize: 16, fontWeight: 600 }}>活跃度分布</span>
                  </div>
                }
                style={{ borderRadius: 16, border: '1px solid #f0f0f0' }}
                headStyle={{ borderBottom: '1px solid #f0f0f0', padding: '16px 20px' }}
                bodyStyle={{ padding: '20px' }}
              >
                <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 12, marginBottom: 20 }}>
                  <div style={{ 
                    padding: 16, 
                    background: '#f6ffed', 
                    borderRadius: 12,
                    border: '1px solid #b7eb8f',
                    textAlign: 'center'
                  }}>
                    <div style={{ fontSize: 28, fontWeight: 800, color: '#52c41a' }}>
                      {computedStats?.activeProblems || 0}
                    </div>
                    <div style={{ fontSize: 12, color: '#73d13d', fontWeight: 500 }}>活跃题目 (&gt;100人)</div>
                  </div>
                  <div style={{ 
                    padding: 16, 
                    background: '#fff7e6', 
                    borderRadius: 12,
                    border: '1px solid #ffd591',
                    textAlign: 'center'
                  }}>
                    <div style={{ fontSize: 28, fontWeight: 800, color: '#fa8c16' }}>
                      {computedStats?.veryActiveProblems || 0}
                    </div>
                    <div style={{ fontSize: 12, color: '#ffa940', fontWeight: 500 }}>超热题目 (&gt;300人)</div>
                  </div>
                </div>
                <Divider style={{ margin: '16px 0' }} />
                <div style={{ fontSize: 14, color: '#595959', lineHeight: 2 }}>
                  <div style={{ display: 'flex', justifyContent: 'space-between' }}>
                    <span>中位数在线</span>
                    <strong style={{ color: '#262626' }}>{computedStats?.medianOnline || 0} 人</strong>
                  </div>
                  <div style={{ display: 'flex', justifyContent: 'space-between' }}>
                    <span>最高在线</span>
                    <strong style={{ color: '#fa8c16' }}>{computedStats?.maxOnline || 0} 人</strong>
                  </div>
                  <div style={{ display: 'flex', justifyContent: 'space-between' }}>
                    <span>最低在线</span>
                    <strong style={{ color: '#8c8c8c' }}>{computedStats?.minOnline || 0} 人</strong>
                  </div>
                </div>
              </Card>
            </Col>
          </Row>
        </div>
      </section>

      {/* ========== CTA Section ========== */}
      <section style={{
        background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
        padding: '80px 24px',
        textAlign: 'center'
      }}>
        <div style={{ maxWidth: 600, margin: '0 auto' }}>
          <h2 style={{
            fontSize: 40,
            fontWeight: 700,
            color: '#fff',
            marginBottom: 20,
            letterSpacing: '-0.5px'
          }}>
            开始探索热门题目
          </h2>
          <p style={{
            fontSize: 18,
            color: 'rgba(255,255,255,0.9)',
            marginBottom: 32,
            lineHeight: 1.6
          }}>
            查看完整的 LeetCode Hot 100 实时排行榜，发现最受欢迎的算法题目
          </p>
          <Space size="middle">
            <Link to="/rankings">
              <Button 
                type="primary" 
                size="large"
                icon={<RocketOutlined />}
                style={{
                  height: 52,
                  padding: '0 40px',
                  fontSize: 17,
                  fontWeight: 600,
                  borderRadius: 12,
                  background: '#fff',
                  color: '#667eea',
                  border: 'none',
                  boxShadow: '0 8px 24px rgba(0,0,0,0.2)'
                }}
              >
                查看排行榜
              </Button>
            </Link>
            <Link to="/history">
              <Button 
                size="large"
                icon={<HistoryOutlined />}
                style={{
                  height: 52,
                  padding: '0 40px',
                  fontSize: 17,
                  fontWeight: 500,
                  borderRadius: 12,
                  background: 'rgba(255,255,255,0.15)',
                  color: '#fff',
                  border: '1px solid rgba(255,255,255,0.3)'
                }}
              >
                历史趋势
              </Button>
            </Link>
          </Space>
        </div>
      </section>

      {/* ========== Footer ========== */}
      <footer style={{
        background: '#fff',
        padding: '40px 24px',
        borderTop: '1px solid #f0f0f0'
      }}>
        <div style={{ maxWidth: 1200, margin: '0 auto', textAlign: 'center' }}>
          <div style={{ 
            display: 'flex', 
            justifyContent: 'center', 
            gap: 32, 
            marginBottom: 24,
            flexWrap: 'wrap'
          }}>
            <Link to="/" style={{ color: '#8c8c8c', fontSize: 14, textDecoration: 'none' }}>首页</Link>
            <Link to="/rankings" style={{ color: '#8c8c8c', fontSize: 14, textDecoration: 'none' }}>排行榜</Link>
            <Link to="/statistics" style={{ color: '#8c8c8c', fontSize: 14, textDecoration: 'none' }}>统计</Link>
            <Link to="/history" style={{ color: '#8c8c8c', fontSize: 14, textDecoration: 'none' }}>历史</Link>
            <a 
              href="https://github.com" 
              target="_blank" 
              rel="noopener noreferrer"
              style={{ color: '#8c8c8c', fontSize: 14, textDecoration: 'none' }}
            >
              GitHub
            </a>
          </div>
          <div style={{ fontSize: 13, color: '#bfbfbf' }}>
            <p style={{ marginBottom: 8 }}>
              LeetCode Hot 100 实时监控系统 · 数据每 30 秒更新 · 云端部署 v2.0
            </p>
            <p>
              © {new Date().getFullYear()} All rights reserved.
            </p>
          </div>
        </div>
      </footer>

      {/* 添加CSS动画 */}
      <style>{`
        @keyframes pulse {
          0%, 100% { opacity: 1; }
          50% { opacity: 0.5; }
        }
        
        .feature-card:hover {
          transform: translateY(-4px);
          box-shadow: 0 12px 40px rgba(0,0,0,0.08);
        }
      `}</style>
    </div>
  );
};

                      <div style={{ fontWeight: 600, color: '#262626' }}>{count} 题</div>
                      <div style={{ fontSize: 12, color: '#8c8c8c' }}>{online.toLocaleString()} 人在线</div>
                    </div>
                  </div>
                  <Progress 
                    percent={percentage} 
                    showInfo={false}
                    strokeColor={colors.text}
                    trailColor="#f5f5f5"
                    strokeWidth={6}
                    style={{ margin: 0 }}
                  />
                </div>
              );
            })}
          </Card>

          {/* 活跃度统计 */}
          <Card 
            title={
              <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                <RiseOutlined style={{ color: '#52c41a' }} />
                <span>活跃度分布</span>
              </div>
            }
            style={{ borderRadius: 12, border: '1px solid #f0f0f0', marginBottom: 16 }}
            headStyle={{ borderBottom: '1px solid #f0f0f0', fontWeight: 600 }}
          >
            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 12 }}>
              <div style={{ 
                padding: 12, 
                background: '#f6ffed', 
                borderRadius: 8,
                border: '1px solid #b7eb8f',
                textAlign: 'center'
              }}>
                <div style={{ fontSize: 24, fontWeight: 700, color: '#52c41a' }}>
                  {computedStats?.activeProblems || 0}
                </div>
                <div style={{ fontSize: 12, color: '#73d13d' }}>活跃题目 (&gt;100人)</div>
              </div>
              <div style={{ 
                padding: 12, 
                background: '#fff7e6', 
                borderRadius: 8,
                border: '1px solid #ffd591',
                textAlign: 'center'
              }}>
                <div style={{ fontSize: 24, fontWeight: 700, color: '#fa8c16' }}>
                  {computedStats?.veryActiveProblems || 0}
                </div>
                <div style={{ fontSize: 12, color: '#ffa940' }}>超热题目 (&gt;300人)</div>
              </div>
            </div>
            <Divider style={{ margin: '16px 0' }} />
            <div style={{ fontSize: 13, color: '#595959', lineHeight: 1.6 }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 8 }}>
                <span>中位数在线</span>
                <strong>{computedStats?.medianOnline || 0} 人</strong>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 8 }}>
                <span>最高在线</span>
                <strong style={{ color: '#fa8c16' }}>{computedStats?.maxOnline || 0} 人</strong>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between' }}>
                <span>最低在线</span>
                <strong style={{ color: '#8c8c8c' }}>{computedStats?.minOnline || 0} 人</strong>
              </div>
            </div>
          </Card>

          {/* 快速链接 - 扁平化 */}
          <Card 
            title={
              <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                <LinkOutlined style={{ color: '#1890ff' }} />
                <span>快速导航</span>
              </div>
            }
            style={{ borderRadius: 12, border: '1px solid #f0f0f0' }}
            headStyle={{ borderBottom: '1px solid #f0f0f0', fontWeight: 600 }}
          >
            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 8 }}>
              <Link to="/statistics" style={{ textDecoration: 'none' }}>
                <div style={{ 
                  padding: '12px 16px', 
                  background: '#f0f5ff', 
                  borderRadius: 8,
                  display: 'flex',
                  alignItems: 'center',
                  gap: 8,
                  color: '#1890ff',
                  fontSize: 13,
                  fontWeight: 500,
                  transition: 'all 0.3s'
                }}>
                  <BarChartOutlined /> 详细统计
                </div>
              </Link>
              <Link to="/history" style={{ textDecoration: 'none' }}>
                <div style={{ 
                  padding: '12px 16px', 
                  background: '#f6ffed', 
                  borderRadius: 8,
                  display: 'flex',
                  alignItems: 'center',
                  gap: 8,
                  color: '#52c41a',
                  fontSize: 13,
                  fontWeight: 500
                }}>
                  <HistoryOutlined /> 历史趋势
                </div>
              </Link>
              <Link to="/rankings" style={{ textDecoration: 'none' }}>
                <div style={{ 
                  padding: '12px 16px', 
                  background: '#fff7e6', 
                  borderRadius: 8,
                  display: 'flex',
                  alignItems: 'center',
                  gap: 8,
                  color: '#fa8c16',
                  fontSize: 13,
                  fontWeight: 500
                }}>
                  <TrophyOutlined /> 完整排行
                </div>
              </Link>
              <Link to="/favorites" style={{ textDecoration: 'none' }}>
                <div style={{ 
                  padding: '12px 16px', 
                  background: '#fff0f6', 
                  borderRadius: 8,
                  display: 'flex',
                  alignItems: 'center',
                  gap: 8,
                  color: '#eb2f96',
                  fontSize: 13,
                  fontWeight: 500
                }}>
                  <StarOutlined /> 我的收藏
                </div>
              </Link>
            </div>
          </Card>
        </Col>
      </Row>

      {/* 底部信息 */}
      <div style={{ 
        textAlign: 'center', 
        padding: '20px', 
        color: '#8c8c8c',
        fontSize: 12,
        borderTop: '1px solid #f0f0f0',
        marginTop: 16
      }}>
        <div style={{ display: 'flex', justifyContent: 'center', gap: 24, marginBottom: 8 }}>
          <span>LeetCode Hot 100 实时监控系统</span>
          <span>•</span>
          <span>数据每 30 秒更新</span>
          <span>•</span>
          <span>共监控 {stats.totalProblems} 道题目</span>
        </div>
        <div>基于 WebSocket 实时推送技术 | 云端部署 v2.0</div>
      </div>
    </div>
  );
};

export default Home;
